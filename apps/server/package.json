{
  "name": "@ccweb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Professional local web console for Claude Code — sessions, live metrics, visual approvals",
  "license": "MIT",
  "bin": {
    "ccweb": "bin/ccweb.mjs"
  },
  "files": [
    "dist",
    "public",
    "bin"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
