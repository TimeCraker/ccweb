{
  "name": "ccweb-console",
  "version": "0.1.4",
  "type": "module",
  "description": "Professional local web console for Claude Code — sessions, live metrics, visual approvals",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "agent-sdk",
    "web-console",
    "gui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimeCraker/ccweb.git"
  },
  "author": "TimeCraker",
  "bin": {
    "ccweb": "bin/ccweb.mjs"
  },
  "files": [
    "dist",
    "public",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "prepublishOnly": "cd ../web && pnpm build && cd ../server && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "test:runtime": "node scripts/runtime-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "node-pty": "1.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
