{
  "name": "ccweb",
  "private": true,
  "version": "0.1.0",
  "description": "Professional local web console for Claude Code — sessions, live metrics, visual approvals, full settings UI",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ccweb-console --filter @ccweb/web dev",
    "dev:server": "pnpm --filter ccweb-console dev",
    "dev:web": "pnpm --filter @ccweb/web dev",
    "build": "pnpm --filter @ccweb/web build && pnpm --filter ccweb-console build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
